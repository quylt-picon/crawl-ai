GEMINI_API_TOKEN=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Optional: enables the "Use Web Search API (SerpAPI)" mode in the web-search tab.
SERPAPI_API_KEY=your_serpapi_key_here
APP_HOST=0.0.0.0
APP_PORT=8080
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO
CRAWL_PAGE_TIMEOUT_MS=60000
CRAWL_HEADLESS=true
